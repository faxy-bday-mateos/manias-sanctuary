rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "LJCqjZ6F4cWjob0yCh3oZs5gsXF3";
    }

    match /activityEvents/{eventId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.keys().hasOnly(["timestamp", "page", "type", "action"])
        && request.resource.data.keys().hasAll(["timestamp", "page", "type"])
        && request.resource.data.timestamp == request.time
        && request.resource.data.page is string
        && request.resource.data.page.matches("^[a-zA-Z0-9_-]{1,40}$")
        && request.resource.data.type in ["page_visit", "interaction"]
        && (
          (request.resource.data.type == "page_visit"
            && !("action" in request.resource.data))
          ||
          (request.resource.data.type == "interaction"
            && "action" in request.resource.data
            && request.resource.data.action is string
            && request.resource.data.action.matches("^[a-zA-Z0-9:_-]{1,80}$"))
        );

      allow get, list, delete: if isAdmin();
    }

    match /wishUnlocks/{wishId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && wishId.matches("^wish-(0[1-9]|[1-9][0-9]|100)$")
        && request.resource.data.keys().hasOnly(["unlockedAt"])
        && request.resource.data.unlockedAt == request.time;
      allow delete: if isAdmin();
    }

    match /wallpaperUploads/{ownerUid}/images/{imageId} {
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(["createdAt", "name", "dataUrl"])
        && request.resource.data.keys().hasAll(["createdAt", "name", "dataUrl"])
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 900000
        && request.resource.data.dataUrl.matches("^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$");

      allow get, list: if isAdmin() || (request.auth != null && request.auth.uid == ownerUid);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == ownerUid);
    }
  }
}
